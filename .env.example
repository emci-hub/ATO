# Copy to .env.local and fill in. `.env*.local` is gitignored.
#
# EXPO_PUBLIC_* values are inlined into the client bundle in plain text, so
# treat this key as shipped-with-the-app, not as a server secret.

# Powers both the main Sage/router calls and the narrow crisis classifier call.
# Empty or unset → router falls back to the local provider and crisis detection
# falls back to the keyword net.
EXPO_PUBLIC_GEMINI_API_KEY=

# gemini (default) | local
EXPO_PUBLIC_MODEL_PROVIDER=gemini

# Defaults to gemini-2.5-flash.
EXPO_PUBLIC_GEMINI_MODEL=gemini-2.5-flash
