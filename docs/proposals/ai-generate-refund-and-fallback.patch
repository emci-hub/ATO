   const ok = claim && typeof claim === 'object' && (claim as { ok?: unknown }).ok === true;
   if (!ok) return json({ error: 'quota' }, 429);
 
+  const input = { prompt: clampedPrompt, temperature, maxOutputTokens, responseFormat };
+
+  // ONE claim covers ONE answer. If the first vendor fails, the fallback runs
+  // here under the same claim (the app used to retry with a second request,
+  // which claimed a second unit). Gemini falls back to DeepSeek — the same pair
