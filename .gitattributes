# Force LF for files regex-parsed by offline checks. On Windows `core.autocrlf`
# checks these out as CRLF, which breaks the parse (check:library reads
# library.md and counts "For Sage" blocks with an LF-only regex).
src/content/copy/library.md text eol=lf

# Generated by art:sync, which writes LF. Pinned so a CRLF checkout (core.autocrlf=true)
# never differs from a fresh sync (check:art-registry --fresh).
assets/art/ART_LIBRARY.md text eol=lf
assets/art/registry.json text eol=lf
assets/art/_contact/library.html text eol=lf
assets/art/_contact/library-portable.html text eol=lf
src/art/generated-art.ts text eol=lf
tools/art-viewer/README.md text eol=lf
assets/art/legacy-play-sheets.json text eol=lf
src/play/generated-play-sheets.ts text eol=lf
